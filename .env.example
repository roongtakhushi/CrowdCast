# ---- Optional Database ----------------------------------------------------
# SQLite database path (rooms, content, presentation state, event log).
# Default: ./data/crowdcast.db (auto-created on startup, zero setup needed)
# DATABASE_PATH=./data/crowdcast.db

# ---- Optional -------------------------------------------------------------
# Port the single server listens on (npm start also honours `-p`)
PORT=3000

# Force the base URL encoded in the QR code / join links (e.g. when running in Docker,
# where the container cannot see the host's Wi-Fi address).
# PUBLIC_BASE_URL=http://192.168.1.20:3000

# Where uploaded files are stored (per room, random filenames). Default: ./data/uploads
# UPLOAD_DIR=./data/uploads

# Default attendee cap for new rooms (organizers can change it per room)
MAX_ATTENDEES=300

# Hours an ended room is kept read-only before it and its files are deleted
ENDED_RETENTION_HOURS=24

# Rate limits (requests per minute, per client IP)
RATE_CREATE_PER_MIN=10
RATE_UPLOAD_PER_MIN=40
RATE_JOIN_PER_MIN=1200
RATE_PIN_PER_MIN=6

# debug | info | warn | error
LOG_LEVEL=info
